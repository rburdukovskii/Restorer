<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Restorer" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Restorer">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <%# PWA manifest %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/favicon.ico" type="image/x-icon">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- Подключаем шрифт -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen flex flex-col bg-gray-50 text-gray-900">
    <!-- Подключаем шапку (навигацию) -->
    <%= render "layouts/navigation" %>

    <%# Блок вывода flash-сообщений %>
  <% if flash.any? %>
  <div class="container mx-auto px-4 mt-4">
    <% flash.each do |type, message| %>
      <div class="<%= type.to_s == 'alert' ? 'bg-red-100 text-red-800 border-red-300' : 'bg-green-100 text-green-800 border-green-300' %>
                  px-4 py-3 rounded border mb-2 text-center font-medium">
        <%= message %>
      </div>
    <% end %>
  </div>
<% end %>

    <main class="flex-grow">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8 py-8">
        <%= yield %>
      </div>
    </main>

    <!-- Подвал -->
    <%= render "layouts/footer" if File.exist?(Rails.root.join("app/views/layouts/_footer.html.erb")) %>
  </body>
</html>

