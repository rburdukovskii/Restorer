<% if page.current? %>
  <span class="px-4 py-2 rounded-lg bg-blue-600 text-white font-semibold shadow-sm">
    <%= page %>
  </span>
<% else %>
  <%= link_to page, url,
      class: "px-4 py-2 rounded-lg border-2 border-gray-200 text-gray-700
             hover:border-blue-600 hover:text-blue-600 transition font-medium" %>
<% end %>