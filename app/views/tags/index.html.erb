<section class="max-w-4xl mx-auto px-6 py-12">

  <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Мои теги <span class="text-gray-400 font-normal">· <%= @tags_count %></span></h1>
    </div>

    <%= link_to "Галерея", gallery_path,
        class: "px-5 py-2 rounded-lg font-semibold text-blue-600 bg-white border-2 border-blue-600 hover:bg-blue-50 transition" %>
  </div>

  <%# Поиск %>
  <%= form_with url: tags_path, method: :get, class: "mb-6" do |f| %>
    <%= f.search_field :q, value: params[:q],
        placeholder: "Поиск по тегам...",
        class: "w-full px-4 py-3 border border-gray-200 rounded-lg
               focus:ring-2 focus:ring-blue-600 focus:border-blue-600" %>
  <% end %>

  <%# Список тегов %>
  <% if @tags.any? %>
    <div class="flex flex-wrap gap-3">
      <% @tags.each do |tag| %>
        <div class="group inline-flex items-center gap-2 px-4 py-2 rounded-full bg-white border border-gray-200 hover:border-blue-400 hover:bg-blue-50 transition">
          <%= link_to photos_tag_path(tag), class: "flex items-center gap-2" do %>
            <span class="font-medium text-gray-900">#<%= tag.name %></span>
            <span class="text-xs text-gray-500"><%= tag.uploads.count %></span>
          <% end %>

          <%= button_to tag_path(tag),
              method: :delete,
              data: { turbo_confirm: "Удалить тег «#{tag.name}»? Он будет убран со всех фото." },
              class: "text-gray-400 hover:text-red-500 transition opacity-0 group-hover:opacity-100" do %>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
          <% end %>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-20 bg-gray-50 rounded-2xl">
      <div class="text-6xl mb-4">🏷</div>
      <h3 class="text-xl font-semibold text-gray-900 mb-2">
        <% if params[:q].present? %>
          Ничего не найдено
        <% else %>
          У вас пока нет тегов
        <% end %>
      </h3>
      <p class="text-gray-500 mb-6">
        <% if params[:q].present? %>
          Попробуйте другой запрос
        <% else %>
          Откройте любое фото и добавьте к нему теги
        <% end %>
      </p>
      <%= link_to "Перейти в галерею", gallery_path,
          class: "inline-block px-6 py-3 rounded-lg font-semibold text-white bg-blue-600 hover:bg-blue-700 transition" %>
    </div>
  <% end %>

</section>