<section class="max-w-2xl mx-auto px-6 py-12">

  <%# Breadcrumb %>
  <nav class="flex items-center gap-2 text-sm text-gray-500 mb-4">
    <%= link_to "Галерея", gallery_path, class: "hover:text-gray-900 transition" %>
    <span class="text-gray-300">/</span>
    <%= link_to @album.name, album_path(@album), class: "hover:text-gray-900 transition" %>
    <span class="text-gray-300">/</span>
    <span class="text-gray-900 font-medium">Редактировать</span>
  </nav>

  <h1 class="text-3xl font-bold text-gray-900 mb-8">Редактировать альбом</h1>

  <%= form_with model: @album, class: "space-y-6" do |f| %>
    <% if @album.errors.any? %>
      <div class="p-4 rounded-lg bg-red-50 text-red-700 text-sm">
        <%= @album.errors.full_messages.join(", ") %>
      </div>
    <% end %>

    <div>
      <%= f.label :name, "Название", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.text_field :name, required: true,
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg
                 focus:ring-2 focus:ring-blue-600 focus:border-blue-600" %>
    </div>

    <div>
      <%= f.label :description, "Описание (необязательно)", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.text_area :description, rows: 3,
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg
                 focus:ring-2 focus:ring-blue-600 focus:border-blue-600" %>
    </div>

    <div>
      <%= f.label :cover, "Обложка (необязательно)", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <% if @album.cover.attached? %>
        <div class="mb-3">
          <%= image_tag @album.cover, class: "w-32 h-32 object-cover rounded-lg" %>
        </div>
      <% end %>
      <%= f.file_field :cover, accept: "image/*",
          class: "block w-full text-sm text-gray-500
                 file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0
                 file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
    </div>

    <div class="flex gap-4 pt-2">
      <%= f.submit "Сохранить",
          class: "px-6 py-3 rounded-lg font-semibold text-white bg-blue-600 hover:bg-blue-700 cursor-pointer transition" %>

      <%= link_to "Отмена", album_path(@album),
          class: "px-6 py-3 rounded-lg border-2 border-gray-300 text-gray-600 hover:bg-gray-50 font-semibold transition" %>
    </div>
  <% end %>

  <%# Удаление альбома %>
  <div class="mt-12 pt-8 border-t border-gray-200">
    <p class="text-sm text-gray-500 mb-4">
      Удаление альбома не удаляет фото — они останутся в галерее.
    </p>
    <%= button_to "Удалить альбом", album_path(@album),
        method: :delete,
        data: { turbo_confirm: "Удалить альбом? Фото останутся в галерее." },
        class: "px-5 py-2 rounded-lg font-semibold text-red-600 bg-white
               border-2 border-red-500 hover:bg-red-50 transition cursor-pointer" %>
  </div>

</section>