<section class="max-w-lg mx-auto px-6 py-12">
  <h1 class="text-3xl font-bold text-gray-900 mb-8">Новый альбом</h1>

  <%= form_with model: @album, class: "space-y-6" do |f| %>
    <% if @album.errors.any? %>
      <div class="p-4 rounded-lg bg-red-50 text-red-700 text-sm">
        <%= @album.errors.full_messages.join(", ") %>
      </div>
    <% end %>

    <div>
      <%= f.label :name, "Название", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.text_field :name, required: true,
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
    </div>

    <div>
      <%= f.label :description, "Описание (необязательно)", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.text_area :description, rows: 3,
          class: "w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500" %>
    </div>

    <div>
      <%= f.label :cover, "Обложка (необязательно)", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= f.file_field :cover, accept: "image/*",
          class: "block w-full text-sm text-gray-500 file:mr-4 file:py-2 file:px-4
                 file:rounded-lg file:border-0 file:text-sm file:font-semibold
                 file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100" %>
    </div>

    <div class="flex gap-4">
      <%= f.submit "Создать альбом",
          class: "px-6 py-3 rounded-lg font-semibold text-white bg-blue-600 hover:bg-blue-700 cursor-pointer transition shadow-sm" %>
      <%= link_to "Отмена", gallery_path,
          class: "px-6 py-3 rounded-lg border-2 border-gray-300 text-gray-600 hover:bg-gray-50 font-semibold" %>
    </div>
  <% end %>
</section>