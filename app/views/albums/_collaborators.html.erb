<% if @album.owner?(current_user) %>
  <div class="bg-white rounded-xl border border-gray-200 p-6">
    <h3 class="text-xl font-bold text-gray-900 mb-4">Соавторы</h3>

    <%= form_with url: add_collaborator_album_path(@album), method: :post, class: "mb-6" do |f| %>
      <div class="flex flex-wrap gap-3">
        <%= f.text_field :query, 
            placeholder: "Email или имя пользователя",
            class: "flex-1 min-w-0 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-blue-600",
            required: true %>
        <%= f.select :role, [["Редактор", "editor"]], {}, 
            class: "px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 focus:border-blue-600" %>
        <%= f.submit "Добавить", 
            class: "px-5 py-2 rounded-lg font-semibold text-white bg-blue-600 hover:bg-blue-700 transition cursor-pointer" %>
      </div>
    <% end %>

    <% if @album.album_collaborators.any? %>
      <div class="space-y-3">
        <% @album.album_collaborators.includes(:user).each do |collaborator| %>
          <div class="flex items-center justify-between p-3 bg-gray-50 rounded-lg">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-full bg-blue-100 flex items-center justify-center text-blue-600 font-semibold">
                <%= collaborator.user.initials %>
              </div>
              <div>
                <div class="font-semibold text-gray-900"><%= collaborator.user.display_name %></div>
                <div class="text-sm text-gray-500"><%= collaborator.user.email %></div>
              </div>
            </div>
            <div class="flex items-center gap-3">
              <span class="px-3 py-1 rounded-full bg-blue-100 text-blue-700 text-sm font-medium">
                Редактор
              </span>
              <%= button_to "Удалить", 
                  remove_collaborator_album_path(@album, collaborator_id: collaborator.id),
                  method: :delete,
                  data: { turbo_confirm: "Удалить соавтора?" },
                  class: "text-red-600 hover:text-red-700 text-sm font-medium" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="text-gray-500 text-center py-4">Пока нет соавторов</p>
    <% end %>
  </div>
<% else %>
  <div class="bg-blue-50 border border-blue-200 rounded-xl p-4 mb-6">
    <div class="flex items-center gap-3">
      <div class="text-2xl">👥</div>
      <div>
        <div class="font-semibold text-blue-900">Вы соавтор этого альбома</div>
        <div class="text-sm text-blue-700">Владелец: <%= @album.user.display_name %></div>
      </div>
    </div>
  </div>
<% end %>