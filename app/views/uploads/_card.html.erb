<div id="upload_card_<%= photo.id %>" class="group relative rounded-xl overflow-hidden bg-gray-100">

  <label class="absolute top-2 left-2 z-10 cursor-pointer
        opacity-0 group-hover:opacity-100
        has-[:checked]:opacity-100
        transition-opacity duration-200">
    <input type="checkbox"
           value="<%= photo.id %>"
           data-bulk-select-target="checkbox"
           data-action="change->bulk-select#toggle"
           class="sr-only">
    <span class="flex items-center justify-center w-5 h-5 rounded border-2 border-white bg-white/95 shadow-lg transition-all duration-150">
      <svg class="w-3.5 h-3.5 text-blue-600 opacity-0 transition-opacity"
           fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
      </svg>
    </span>
  </label>

  <%= link_to upload_path(photo) do %>
    <% if photo.processed.attached? && photo.processed.blob.present? %>
      <img src="<%= rails_blob_path(photo.processed) %>" loading="lazy" class="w-full aspect-square object-cover group-hover:scale-105 transition">
    <% else %>
      <div class="w-full aspect-square flex flex-col items-center justify-center bg-gradient-to-br from-gray-100 to-gray-200 gap-3">
        <div class="text-4xl animate-pulse">
          <%= photo.status == "failed" ? "⚠️" : "⏳" %>
        </div>
        <div class="text-xs text-gray-600 font-medium">
          <%= photo.status == "pending" ? "В очереди" : photo.status == "failed" ? "Ошибка" : "Обрабатываем" %>
        </div>
      </div>
    <% end %>
  <% end %>

  <%= render "uploads/progress_inline", upload: photo %>

  <div class="absolute top-2 right-2 flex gap-1 opacity-0 group-hover:opacity-100 transition">
    <div id="favorite_<%= photo.id %>">
      <%= render "uploads/favorite_button", upload: photo %>
    </div>

    <%= button_to upload_path(photo),
        method: :delete,
        form: { data: { turbo_confirm: "Удалить это фото? Действие нельзя отменить." } },
        class: "w-8 h-8 rounded-full bg-white/90 hover:bg-red-500 hover:text-white flex items-center justify-center text-gray-400 transition" do %>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
      </svg>
    <% end %>
  </div>

  <div class="absolute bottom-0 left-0 right-0 px-3 py-2 bg-black/40 backdrop-blur-sm">
    <div class="text-white text-sm font-semibold truncate">
      <%= photo.display_title %>
    </div>
    <% if photo.tags.any? %>
      <div class="text-white/80 text-xs truncate mt-0.5">
        <%= photo.tags.map { |t| "##{t.name}" }.join(" ") %>
      </div>
    <% end %>
  </div>
</div>