<% if user_signed_in? && !@is_public %>
  <%= turbo_stream_from current_user, :uploads %>
<% end %>

<section class="max-w-3xl mx-auto px-6 py-16">
  <% if @is_public %>
    <div class="mb-6 p-4 bg-emerald-50 border border-emerald-200 rounded-xl text-center">
      <p class="text-sm text-emerald-800">
        Просмотров: <strong><%= @share_link.views_count %></strong> · 
        Действует до: <strong><%= @share_link.expires_at.strftime("%d.%m.%Y %H:%M") %></strong>
      </p>
    </div>
  <% end %>

  <h1 class="text-3xl font-bold text-center mb-8">Результат</h1>

  <%= render "uploads/show_result", upload: @upload %>

  <%# Название %>
  <div class="mt-8 p-6 bg-white rounded-2xl shadow-sm border border-gray-200">
    <div class="flex items-center justify-between mb-3">
      <h3 class="text-sm font-semibold text-gray-900">Название</h3>
      <% if @upload.title.present? && !@is_public %>
        <span class="text-xs text-emerald-600">● сохранено</span>
      <% end %>
    </div>

    <% form_url = @is_public ? "#" : upload_path(@upload) %>
    <%= form_with model: @upload, url: form_url, method: :patch, class: "flex gap-2" do |f| %>
      <%= f.text_field :title, value: @upload.title, placeholder: "Название...", class: "flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 text-sm #{'bg-gray-100 cursor-not-allowed' if @is_public}", disabled: @is_public %>
      
      <% unless @is_public %>
        <%= f.submit "Сохранить", class: "px-5 py-2 rounded-lg font-semibold text-white bg-blue-600 hover:bg-blue-700 transition text-sm cursor-pointer" %>
      <% end %>
    <% end %>
  </div>

  <%# Теги %>
  <div class="mt-8 p-6 bg-white rounded-2xl shadow-sm border border-gray-200">
    <h3 class="text-sm font-semibold text-gray-900 mb-3">Теги</h3>
    <div class="flex flex-wrap gap-2 mb-4">
      <% @upload.tags.each do |tag| %>
        <span class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-blue-100 text-blue-700 text-sm font-medium">
          #<%= tag.name %>
        </span>
      <% end %>
    </div>
    
    <% unless @is_public %>
      <form data-action="submit->tag-input#add" class="flex gap-2 mb-2">
        <input type="text" placeholder="Добавить новый тег..." class="flex-1 px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-600 text-sm">
        <button type="submit" class="px-5 py-2 rounded-lg font-semibold text-white bg-blue-600 hover:bg-blue-700 transition text-sm cursor-pointer">Добавить</button>
      </form>
    <% end %>
  </div>

  <%# Кнопка скачивания и Публичная ссылка %>
  <% if @is_public %>
    <%= link_to "Скачать изображение", public_share_download_path(@share_link.token, photo: params[:photo]), class: "mt-8 block text-center w-full text-white font-semibold py-3 px-6 rounded-xl bg-blue-600 hover:bg-blue-700" %>
  <% else %>
    <%= render "uploads/download_button", upload: @upload %>
    <%= render "uploads/share_link", upload: @upload, share_link: @upload.share_links.active.order(created_at: :desc).first %>
  <% end %>
</section>