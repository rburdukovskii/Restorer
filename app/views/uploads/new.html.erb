<section class="max-w-2xl mx-auto px-6 py-16">
  <h1 class="text-3xl font-bold text-center mb-2">Загрузите фото</h1>
  <p class="text-center text-gray-500 mb-8">Восстановим и наложим фильтр</p>

  <%= form_with model: @upload, url: uploads_path, multipart: true, class: "space-y-6" do |f| %>
    <% if @upload.errors.any? %>
      <div class="p-4 rounded-lg bg-red-50 text-red-700 text-sm">
        <%= @upload.errors.full_messages.join(", ") %>
      </div>
    <% end %>

    <%# Зона загрузки %>
    <%= render "components/file_upload", form: f, field: :original %>

    <%# Выбор фильтра %>
    <div class="mt-8" data-controller="filter-picker">
      <h2 class="text-lg font-semibold text-gray-900 mb-3">Выберите фильтр</h2>

      <%= hidden_field_tag "upload[filter_name]", Filter.default,
          data: { "filter-picker-target": "input" } %>

      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
        <% Filter.all.each do |slug, filter| %>
          <button type="button"
                  data-filter-picker-target="option"
                  data-action="click->filter-picker#select"
                  data-slug="<%= slug %>"
                  class="p-3 rounded-xl border-2 text-center transition
                         <%= slug == Filter.default ? 'border-blue-600 bg-blue-50' : 'border-gray-200 hover:border-blue-300 hover:bg-blue-50/30' %>">
            <div class="text-2xl mb-1"><%= filter[:icon] %></div>
            <div class="text-sm font-medium text-gray-900"><%= filter[:name] %></div>
          </button>
        <% end %>
      </div>
    </div>

    <%= f.submit "Обработать",
        class: "w-full cursor-pointer text-white font-semibold py-3 px-6 rounded-xl transition hover:opacity-90 mt-6",
        style: "background: linear-gradient(135deg, #4F46E5, #EC4899);" %>
  <% end %>
</section>