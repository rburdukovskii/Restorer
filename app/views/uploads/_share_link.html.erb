<div id="upload_share_link_<%= upload.id %>" class="mt-8 p-6 bg-white rounded-2xl shadow-sm border border-gray-200">
  <h3 class="text-sm font-semibold text-gray-900 mb-3">Публичная ссылка</h3>
  
  <% if share_link %>
    <p class="text-xs text-gray-500 mb-3">
      Действует до <strong><%= share_link.expires_at.strftime("%d.%m.%Y %H:%M") %></strong>.
      Просмотров: <strong><%= share_link.views_count %></strong>.
    </p>

    <div class="flex gap-2 mb-3" data-controller="clipboard">
      <input type="text" readonly value="<%= public_share_url(share_link.token) %>"
             data-clipboard-target="source"
             class="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm bg-gray-50 font-mono">
      <button type="button" data-action="click->clipboard#copy"
              class="px-4 py-2 rounded-lg font-semibold text-white bg-blue-600 hover:bg-blue-700 transition text-sm cursor-pointer">
        Копировать
      </button>
      <%= link_to "Открыть", public_share_path(share_link.token), target: "_blank",
          class: "px-4 py-2 rounded-lg font-semibold text-blue-600 bg-blue-50 hover:bg-blue-100 transition text-sm" %>
    </div>

    <div class="text-right">
      <%= button_to "Создать новую ссылку",
          regenerate_share_link_path(share_link),
          method: :post,
          form: { data: { turbo_stream: true, turbo_confirm: "Старая ссылка перестанет работать. Продолжить?" } },
          class: "text-xs font-semibold text-red-600 hover:text-red-700 cursor-pointer" %>
    </div>
  <% else %>
    <p class="text-xs text-gray-500 mb-3">Ссылка еще не создана.</p>
    <%= button_to "Поделиться",
        share_links_path(shareable_type: "Upload", shareable_id: upload.id),
        method: :post,
        form: { data: { turbo_stream: true } },
        class: "px-4 py-2 rounded-lg font-semibold text-white bg-blue-600 hover:bg-blue-700 transition text-sm cursor-pointer" %>
  <% end %>
</div>