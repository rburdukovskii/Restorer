<section class="max-w-2xl mx-auto px-6 py-12">
  <h1 class="text-3xl font-bold text-gray-900 mb-2">Добавить в альбомы</h1>
  <p class="text-gray-500 mb-8"><%= @upload.display_title %></p>

  <%# Миниатюра %>
  <div class="mb-8">
    <%= image_tag (@upload.processed.attached? ? @upload.processed : @upload.original),
        class: "w-full max-h-64 object-cover rounded-xl shadow-lg" %>
  </div>

  <%= form_with url: assign_to_album_upload_path(@upload), method: :post, class: "space-y-4" do |f| %>

    <% if @albums.any? %>
      <div class="space-y-2">
        <% @albums.each do |album| %>
          <label class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:bg-blue-50 cursor-pointer transition">
            <input type="checkbox"
                   name="album_ids[]"
                   value="<%= album.id %>"
                   <%= "checked" if @upload.albums.include?(album) %>
                   class="w-5 h-5 rounded border-gray-300 text-blue-600 focus:ring-blue-500">
            <div class="flex-1">
              <div class="font-medium text-gray-900"><%= album.name %></div>
              <div class="text-xs text-gray-500"><%= album.photos_count %> фото</div>
            </div>
          </label>
        <% end %>
      </div>
    <% else %>
      <div class="text-center py-8 bg-gray-50 rounded-xl">
        <div class="text-4xl mb-2">📁</div>
        <p class="text-gray-500 mb-4">У вас пока нет альбомов</p>
        <%= link_to "Создать первый альбом", new_album_path,
            class: "inline-block px-6 py-2.5 rounded-lg font-semibold text-white bg-blue-600 hover:bg-blue-700 transition" %>
      </div>
    <% end %>

    <%# Кнопки %>
    <div class="flex gap-4 pt-4">
      <%= f.submit "Сохранить",
          class: "px-6 py-3 rounded-lg font-semibold text-white bg-blue-600 hover:bg-blue-700 cursor-pointer transition" %>

      <%= link_to "Отмена", upload_path(@upload),
          class: "px-6 py-3 rounded-lg border-2 border-gray-300 text-gray-600 hover:bg-gray-50 font-semibold transition" %>
    </div>
  <% end %>
</section>