<section class="max-w-7xl mx-auto px-6 py-12">
  <nav class="flex items-center gap-2 text-sm text-gray-500 mb-4">
    <span>Публичный альбом</span>
    <span class="text-gray-300">/</span>
    <span class="text-gray-900 font-medium"><%= @shareable.name %></span>
  </nav>

  <div class="mb-8">
    <h1 class="text-3xl font-bold text-gray-900"><%= @shareable.name %></h1>
    <p class="text-gray-500 mt-1">
      <%= @uploads.count %> фото
      <% if @shareable.description.present? %>
        · <%= @shareable.description %>
      <% end %>
    </p>
    <p class="text-sm text-gray-500 mt-2">
      Просмотров: <span class="font-semibold text-gray-900"><%= @share_link.views_count %></span>
      · действует до <%= @share_link.expires_at.strftime("%d.%m.%Y %H:%M") %>
    </p>
  </div>

  <% if @uploads.any? %>
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
      <% @uploads.each do |photo| %>
        <!-- Клик ведет на публичную страницу фото с параметром ?photo= -->
        <%= link_to public_share_path(@share_link.token, photo: photo.id),
            class: "group relative rounded-xl overflow-hidden bg-gray-100 block" do %>
          <% if photo.processed.attached? %>
            <%= image_tag photo.processed, class: "w-full aspect-square object-cover group-hover:scale-105 transition", alt: photo.display_title %>
          <% elsif photo.original.attached? %>
            <%= image_tag photo.original, class: "w-full aspect-square object-cover group-hover:scale-105 transition", alt: photo.display_title %>
          <% end %>
          
          <div class="absolute bottom-0 left-0 right-0 px-3 py-2 bg-black/40 backdrop-blur-sm">
            <div class="text-white text-sm font-semibold truncate"><%= photo.display_title %></div>
          </div>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-20 bg-gray-50 rounded-2xl">
      <div class="text-6xl mb-4">📁</div>
      <p class="text-gray-500">В альбоме пока нет фото</p>
    </div>
  <% end %>
</section>