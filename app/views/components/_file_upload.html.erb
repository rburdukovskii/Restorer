<div data-controller="image-preview dropzone"
     data-dropzone-image-preview-outlet="#preview-<%= field %>"
     id="preview-<%= field %>"
     data-action="
       dragenter->dropzone#dragOver
       dragover->dropzone#dragOver
       dragleave->dropzone#dragLeave
       drop->dropzone#drop">

  <div class="relative mb-4">
    <img data-image-preview-target="canvas"
         hidden
         class="object-cover w-full max-h-80 rounded-xl shadow-lg">

    <button type="button"
            data-image-preview-target="removeButton"
            data-action="click->image-preview#remove"
            hidden
            aria-label="Удалить фото"
            class="absolute top-3 right-3 w-9 h-9 rounded-full
                   bg-black/60 hover:bg-black/80 text-white
                   flex items-center justify-center
                   backdrop-blur-sm transition-colors duration-200
                   shadow-lg">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
              d="M6 18L18 6M6 6l12 12"/>
      </svg>
    </button>
  </div>

  <%# Зона загрузки %>
  <label data-dropzone-target="zone"
         data-image-preview-target="zone"
         class="block cursor-pointer rounded-2xl border-2 border-dashed border-gray-300 p-10 text-center transition hover:border-indigo-400 hover:bg-indigo-50/30">

    <p class="text-lg font-semibold text-gray-900">Перетащите фото сюда</p>
    <p class="text-sm text-gray-500 mt-1">или нажмите, чтобы выбрать</p>
    <p class="text-xs text-gray-400 mt-2">JPG, PNG, WebP · до 20 МБ</p>

    <%= form.file_field field,
        accept: "image/jpeg,image/png,image/webp",
        style: "position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0;",
        data: {
          dropzone_target: "input",
          image_preview_target: "source",
          action: "change->image-preview#show"
        } %>
  </label>
</div>