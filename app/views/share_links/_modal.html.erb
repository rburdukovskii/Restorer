<div id="share_link_modal" class="fixed inset-0 z-50 flex items-center justify-center bg-black/60 backdrop-blur-sm p-4"
     data-controller="modal" data-action="click->modal#closeOnBackdrop">
  <div class="bg-white rounded-2xl shadow-2xl max-w-lg w-full p-6" data-modal-target="panel">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-xl font-bold text-gray-900">Публичная ссылка</h2>
      <button type="button" onclick="document.getElementById('album_share_modal_<%= share_link.shareable_id %>').classList.add('hidden')" class="text-gray-400 hover:text-gray-600 text-2xl leading-none cursor-pointer">&times;</button>
    </div>

    <p class="text-sm text-gray-500 mb-4">
      Действует до <strong><%= share_link.expires_at.strftime("%d.%m.%Y %H:%M") %></strong>.
    </p>

    <%# Рендерим инпут с ссылкой %>
    <%= render "share_links/input", share_link: share_link %>

    <div class="flex items-center justify-between pt-4 border-t border-gray-100">
      <span class="text-xs text-gray-400">Ссылка активна</span>
      
      <%# Кнопка перевыпуска отправляет Turbo Stream %>
      <%= button_to "Создать новую ссылку",
          regenerate_share_link_path(share_link),
          method: :post,
          form: { data: { turbo_stream: true, turbo_confirm: "Старая ссылка перестанет работать. Продолжить?" } },
          class: "text-sm font-semibold text-red-600 hover:text-red-700 cursor-pointer" %>
    </div>
  </div>
</div>