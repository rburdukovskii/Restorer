<section class="max-w-7xl mx-auto px-6 py-12">

  <%# Заголовок + действия %>
  <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
    <div>
      <h1 class="text-3xl font-bold text-gray-900">Моя галерея</h1>
      <p class="text-gray-500 mt-1">
        <%= @uploads.respond_to?(:total_count) ? @uploads.total_count : @uploads.size %> фото
      </p>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= link_to new_upload_path,
          class: "px-5 py-2 rounded-lg font-semibold text-white bg-blue-600 hover:bg-blue-700 transition shadow-sm" do %>
        + Загрузить фото
      <% end %>

      <%= link_to new_album_path,
          class: "px-5 py-2 rounded-lg font-semibold text-blue-600 bg-white border-2 border-blue-600 hover:bg-blue-50 transition" do %>
        + Создать альбом
      <% end %>

      <%= link_to tags_path,
          class: "px-5 py-2 rounded-lg font-semibold text-blue-600 bg-white border-2 border-blue-600 hover:bg-blue-50 transition flex items-center gap-2" do %>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/>
        </svg>
        Теги
      <% end %>
    </div>
  </div>

  <%# Панель фильтров %>
  <div class="bg-white rounded-xl shadow-sm p-4 mb-8 flex flex-wrap items-center gap-3">
    <%= link_to gallery_path,
        class: "px-4 py-1.5 rounded-full text-sm font-medium transition
               #{!gallery_filter_active?(:favorites, :without_album, :album, :tag) ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" do %>
      Все
    <% end %>

    <%= link_to gallery_path(favorites: 1),
        class: "px-4 py-1.5 rounded-full text-sm font-medium transition
               #{gallery_filter_active?(:favorites) ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" do %>
      ★ Избранное
    <% end %>

    <%= link_to gallery_path(without_album: 1),
        class: "px-4 py-1.5 rounded-full text-sm font-medium transition
               #{gallery_filter_active?(:without_album) ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'}" do %>
      Без альбома
    <% end %>

    <% if @tags.any? %>
      <div class="relative" data-controller="dropdown">
        <button type="button"
                data-action="click->dropdown#toggle"
                class="flex items-center gap-2 px-4 py-1.5 rounded-full text-sm font-medium transition
                      <%= params[:tag].present? ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200' %>">
          <span><%= params[:tag].present? ? "##{params[:tag]}" : "# Теги" %></span>
          <svg class="w-3 h-3 transition-transform" data-dropdown-target="arrow"
              fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                  d="M19 9l-7 7-7-7"/>
          </svg>
        </button>

        <%# Список %>
        <div data-dropdown-target="menu"
            class="hidden absolute top-full left-0 mt-2 w-64 bg-white rounded-xl shadow-xl border border-gray-100 z-30 max-h-80 overflow-y-auto">

          <%# Все теги %>
          <div class="p-2">
            <%= link_to gallery_path,
                class: "block px-3 py-2 rounded-lg text-sm transition
                      #{params[:tag].blank? ? 'bg-blue-50 text-blue-700 font-medium' : 'text-gray-700 hover:bg-gray-50'}" do %>
              Все фото
            <% end %>

            <% @tags.each do |tag| %>
              <%= link_to gallery_path(tag: tag.name),
                  class: "flex items-center justify-between px-3 py-2 rounded-lg text-sm transition
                        #{params[:tag] == tag.name ? 'bg-blue-50 text-blue-700 font-medium' : 'text-gray-700 hover:bg-gray-50'}" do %>
                <span>#<%= tag.name %></span>
                <span class="text-xs text-gray-400"><%= tag.uploads.count %></span>
              <% end %>
            <% end %>
          </div>
        </div>
      </div>
    <% end %>

    <%= form_with url: gallery_path, method: :get, class: "flex-1 min-w-[200px]" do |f| %>
      <%= f.search_field :q, value: params[:q],
          placeholder: "Поиск по названию...",
          class: "w-full px-4 py-2 border border-gray-200 rounded-lg text-sm
                 focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500" %>
    <% end %>

    <%= form_with url: gallery_path, method: :get, class: "flex items-center gap-2" do |f| %>
      <%= f.select :sort,
          options_for_select([
            ["Сначала новые", "newest"],
            ["Сначала старые", "oldest"],
            ["По названию", "title"]
          ], params[:sort]),
          {},
          class: "px-3 py-2 border border-gray-200 rounded-lg text-sm bg-white",
          onchange: "this.form.submit()" %>
    <% end %>
  </div>

  <%# Лента альбомов %>
  <% if @albums.any? %>
    <div class="mb-8">
      <h2 class="text-lg font-bold text-gray-900 mb-3">Альбомы</h2>
      <div class="flex gap-4 overflow-x-auto pb-2">
        <% @albums.each do |album| %>
          <%= link_to album_path(album), class: "shrink-0 w-40 group" do %>
            <div class="w-40 h-40 rounded-xl overflow-hidden bg-gray-100 mb-2">
              <% if album.cover_image.present? %>
                <%= image_tag album.cover_image, class: "w-full h-full object-cover group-hover:scale-105 transition" %>
              <% else %>
                <div class="w-full h-full flex items-center justify-center text-gray-300 text-3xl">📁</div>
              <% end %>
            </div>
            <div class="text-sm font-medium text-gray-900 truncate"><%= album.name %></div>
            <div class="text-xs text-gray-500"><%= album.photos_count %> фото</div>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>

  <%# Сетка фото %>
  <% if @uploads.any? %>
    <div data-controller="bulk-select album-modal"
         data-album-modal-url-value="<%= bulk_add_to_album_uploads_path %>">

      <%# Панель управления %>
      <div class="flex items-center justify-between mb-4">
        <div class="flex gap-2">
          <button type="button"
                  data-action="click->bulk-select#selectAll"
                  class="px-3 py-1.5 text-sm rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50 transition">
            Выбрать все
          </button>
          <button type="button"
                  data-action="click->bulk-select#deselectAll"
                  class="px-3 py-1.5 text-sm rounded-lg border border-gray-200 text-gray-600 hover:bg-gray-50 transition">
            Снять выделение
          </button>
        </div>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        <% @uploads.each do |photo| %>
          <div class="group relative rounded-xl overflow-hidden bg-gray-100">

            <%# Чекбокс %>
            <label class="absolute top-2 left-2 z-10 cursor-pointer
                  opacity-0 group-hover:opacity-100
                  has-[:checked]:opacity-100
                  transition-opacity duration-200">
              <input type="checkbox"
                     value="<%= photo.id %>"
                     data-bulk-select-target="checkbox"
                     data-action="change->bulk-select#toggle"
                     class="sr-only">
              <span class="flex items-center justify-center
                           w-5 h-5 rounded border-2 border-white bg-white/95
                           shadow-lg transition-all duration-150">
                <svg class="w-3.5 h-3.5 text-blue-600 opacity-0 transition-opacity"
                     fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
              </span>
            </label>

            <%= link_to upload_path(photo) do %>
              <%= image_tag (photo.processed.attached? ? photo.processed : photo.original),
                  class: "w-full aspect-square object-cover group-hover:scale-105 transition" %>
            <% end %>

            <%# Верхняя панель с действиями %>
            <div class="absolute top-2 right-2 flex gap-1 opacity-0 group-hover:opacity-100 transition">
              <div id="favorite_<%= photo.id %>">
                <%= render "uploads/favorite_button", upload: photo %>
              </div>

              <%= button_to upload_path(photo),
                  method: :delete,
                  data: { turbo_confirm: "Удалить это фото? Действие нельзя отменить." },
                  class: "w-8 h-8 rounded-full bg-white/90 hover:bg-red-500 hover:text-white
                        flex items-center justify-center text-gray-400 transition" do %>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                </svg>
              <% end %>
            </div>

            <%# Нижняя панель с названием %>
            <div class="absolute bottom-0 left-0 right-0 px-3 py-2 bg-black/40 backdrop-blur-sm">
              <div class="text-white text-sm font-semibold truncate">
                <%= photo.display_title %>
              </div>
              <% if photo.tags.any? %>
                <div class="text-white/80 text-xs truncate mt-0.5">
                  <%= photo.tags.map { |t| "##{t.name}" }.join(" ") %>
                </div>
              <% end %>
            </div>
          </div>
        <% end %>
      </div>

      <%# Плавающая панель снизу %>
      <div data-bulk-select-target="panel"
           class="fixed bottom-6 left-1/2 -translate-x-1/2 z-40
                  bg-gray-900/85 backdrop-blur-md text-white
                  rounded-2xl shadow-2xl border border-white/10
                  transform translate-y-[200%] transition-transform duration-300
                  max-w-2xl w-[calc(100%-2rem)]">
        <div class="px-6 py-3 flex items-center justify-between gap-6">

          <%# Счётчик %>
          <div class="flex items-center gap-3">
            <span class="text-sm text-gray-300">Выбрано:</span>
            <span data-bulk-select-target="count" class="text-2xl font-bold">0</span>
          </div>

          <%# Кнопки действий %>
          <div class="flex items-center gap-3">

            <%# В альбом %>
            <button type="button"
                    data-action="click->album-modal#open"
                    class="px-4 py-2 rounded-lg font-semibold text-blue-300
                           bg-white/5 border border-blue-400/30
                           hover:bg-blue-600 hover:text-white hover:border-blue-500
                           cursor-pointer transition text-sm">
              В альбом
            </button>

            <%# Удалить %>
            <%= form_with url: bulk_destroy_uploads_path,
                method: :delete,
                data: { turbo_confirm: "Удалить выбранные фото? Действие нельзя отменить." },
                class: "inline" do |f| %>
              <div data-bulk-select-target="hiddenInputs"></div>
              <%= f.submit "Удалить",
                  class: "px-4 py-2 rounded-lg font-semibold text-red-300
                         bg-white/5 border border-red-400/30
                         hover:bg-red-500 hover:text-white hover:border-red-500
                         cursor-pointer transition text-sm" %>
            <% end %>

            <%# Отменить %>
            <button type="button"
                    data-action="click->bulk-select#deselectAll"
                    class="text-sm text-gray-400 hover:text-white transition">
              Отменить
            </button>
          </div>
        </div>
      </div>

      <%# Модалка выбора альбома %>
      <div data-album-modal-target="modal"
           class="hidden fixed inset-0 z-50 items-center justify-center bg-black/60 backdrop-blur-sm p-4">
        <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 relative">

          <button type="button"
                  data-action="click->album-modal#close"
                  class="absolute top-3 right-3 text-gray-400 hover:text-gray-600 text-2xl leading-none cursor-pointer">
            &times;
          </button>

          <h2 class="text-xl font-bold text-gray-900 mb-4">Добавить в альбом</h2>

          <form data-action="submit->album-modal#submit">

            <%# Существующие альбомы %>
            <% if @albums.any? %>
              <div class="space-y-2 mb-3 max-h-64 overflow-y-auto">
                <% @albums.each do |album| %>
                  <label class="flex items-center gap-3 p-3 rounded-lg border border-gray-200 hover:bg-blue-50 cursor-pointer transition">
                    <input type="radio"
                           name="album_choice"
                           value="<%= album.id %>"
                           data-album-modal-target="albumRadio"
                           data-action="change->album-modal#toggleNewAlbum"
                           class="w-4 h-4 text-blue-600 focus:ring-blue-500">
                    <div class="flex-1">
                      <div class="font-medium text-gray-900"><%= album.name %></div>
                      <div class="text-xs text-gray-500"><%= album.photos_count %> фото</div>
                    </div>
                  </label>
                <% end %>
              </div>
            <% end %>

            <%# Создать новый %>
            <label class="flex items-center gap-3 p-3 rounded-lg border-2 border-dashed border-gray-300 hover:bg-blue-50 cursor-pointer transition mb-3">
              <input type="radio"
                     name="album_choice"
                     value="new"
                     data-album-modal-target="albumRadio"
                     data-action="change->album-modal#toggleNewAlbum"
                     class="w-4 h-4 text-blue-600 focus:ring-blue-500">
              <span class="font-medium text-gray-700">Создать новый альбом</span>
            </label>

            <%# Поле нового имени %>
            <div data-album-modal-target="newAlbumWrapper" class="hidden mb-4">
              <input type="text"
                     placeholder="Название альбома"
                     data-album-modal-target="newAlbumInput"
                     class="w-full px-4 py-2 border border-gray-300 rounded-lg
                            focus:ring-2 focus:ring-blue-500 focus:border-blue-500">
            </div>

            <%# Кнопки %>
            <div class="flex gap-3 pt-2">
              <button type="submit"
                      class="flex-1 px-5 py-2.5 rounded-lg font-semibold text-white
                             bg-blue-600 hover:bg-blue-700 transition cursor-pointer">
                Добавить
              </button>
              <button type="button"
                      data-action="click->album-modal#close"
                      class="px-5 py-2.5 rounded-lg font-semibold text-gray-600
                             border border-gray-300 hover:bg-gray-50 transition cursor-pointer">
                Отмена
              </button>
            </div>
          </form>
        </div>
      </div>

      <%# Пагинация %>
      <% if @uploads.respond_to?(:current_page) %>
        <div class="mt-8 flex justify-center">
          <%= paginate @uploads %>
        </div>
      <% end %>
    </div>
  <% else %>
    <%# Пустое состояние %>
    <div class="text-center py-20">
      <div class="text-6xl mb-4">📷</div>
      <h3 class="text-xl font-semibold text-gray-900 mb-2">
        <% if gallery_filter_active?(:favorites, :without_album, :album, :tag, :q) %>
          Ничего не найдено
        <% else %>
          У вас пока нет фото
        <% end %>
      </h3>
      <p class="text-gray-500 mb-6">
        <% if gallery_filter_active?(:favorites, :without_album, :album, :tag, :q) %>
          Попробуйте изменить фильтры
        <% else %>
          Загрузите первое фото — оно появится здесь
        <% end %>
      </p>

      <% if gallery_filter_active?(:favorites, :without_album, :album, :tag, :q) %>
        <%= link_to "Сбросить фильтры", gallery_path,
            class: "inline-block px-6 py-3 rounded-lg border-2 border-indigo-500 text-indigo-500
                   hover:bg-indigo-50 font-semibold transition" %>
      <% else %>
        <%= link_to "Загрузить фото", new_upload_path,
            class: "inline-block px-6 py-3 rounded-lg font-semibold text-white",
            style: "background: linear-gradient(135deg, #4F46E5, #EC4899);" %>
      <% end %>
    </div>
  <% end %>

</section>